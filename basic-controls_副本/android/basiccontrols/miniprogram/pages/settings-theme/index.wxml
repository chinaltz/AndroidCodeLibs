<view class="page-shell" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <bc-top-bar title="{{title}}" show-back="{{true}}" bg-color="{{theme.pageStart}}" theme="{{theme}}" bind:back="onBack" />
  <scroll-view scroll-y class="page-body page-scroll">
    <view style="font-size:26rpx;color:{{theme.textTertiary}};">{{hint}}</view>
    <bc-card theme="{{theme}}">
      <view
        wx:for="{{options}}"
        wx:key="key"
        class="option-row"
        style="background: {{item.selected ? theme.selectedFill : theme.surfaceRaised}}; border-color: {{item.selected ? theme.success : theme.borderDefault}};"
        data-key="{{item.key}}"
        bindtap="onPick"
      >{{item.label}}</view>
    </bc-card>
  </scroll-view>
</view>
