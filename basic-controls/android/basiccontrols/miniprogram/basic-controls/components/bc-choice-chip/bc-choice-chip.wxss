:host {
  display: inline-block;
  flex-shrink: 0;
}

.bc-choice {
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--bc-border);
  border-radius: 18rpx;
  background: var(--bc-surface);
  color: var(--bc-muted);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
  flex-shrink: 0;
  gap: 8rpx;
}

.bc-choice-text {
  line-height: 1.2;
}

.bc-choice-count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(23, 58, 98, 0.08);
  color: var(--bc-muted);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.bc-choice.is-selected .bc-choice-count {
  background: var(--bc-brand);
  color: #FFFFFF;
}

.bc-choice.is-large {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.bc-choice.is-selected {
  border-color: var(--bc-brand);
  background: var(--bc-active);
  color: var(--bc-brand);
}

.bc-choice.is-danger {
  color: var(--bc-danger);
}

.bc-choice.is-danger.is-selected {
  border-color: var(--bc-danger);
}

.bc-choice.is-disabled {
  opacity: 0.45;
}
