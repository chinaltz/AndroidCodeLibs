.reward-card { margin-top: 24rpx; padding: 40rpx 28rpx; border-radius: 36rpx; background: #fff; border: 2rpx solid #d8eef8; text-align: center; box-shadow: 0 18rpx 40rpx rgba(23,58,98,.1); }
.reward-badge { display: inline-flex; padding: 10rpx 22rpx; border-radius: 999rpx; background: #e8fdf7; color: #0c8f7e; font-size: 23rpx; font-weight: 900; }
.reward-title { margin-top: 24rpx; font-size: 42rpx; font-weight: 900; color: #173a62; }
.reward-points { margin-top: 20rpx; font-size: 52rpx; font-weight: 900; color: #f39a25; }
.reward-xp,.reward-tip { margin-top: 12rpx; font-size: 23rpx; line-height: 1.5; color: #7895ae; }
.reward-share { margin-top: 30rpx; min-height: 88rpx; border: 0; border-radius: 24rpx; background: #0c8f7e; color: #fff; font-size: 28rpx; font-weight: 900; line-height: 88rpx; }
.reward-share::after { border: 0; }
.reward-link,.reward-back { margin-top: 18rpx; min-height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 900; }
.reward-link { color: #0c8f7e; }
.reward-back { border-radius: 22rpx; border: 2rpx solid #d6e4e0; color: #4a7a72; }
