<view class="page-shell" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <bc-top-bar title="{{title}}" show-back="{{true}}" bg-color="{{theme.pageStart}}" theme="{{theme}}" bind:back="onBack" />

  <scroll-view scroll-y class="page-body page-scroll">
    <view class="mt-card" style="color: {{theme.textTertiary}}; font-size: 26rpx;">{{subtitle}}</view>

    <view class="mt-card">
    <bc-card theme="{{theme}}">
      <view class="settings-row" bindtap="goTheme">
        <view class="settings-row__main">
          <view class="settings-row__title">{{entryTheme}}</view>
          <view class="settings-row__value" style="color: {{theme.textTertiary}};">{{themeLabel}}</view>
        </view>
        <view class="settings-row__chev" style="color: {{theme.textTertiary}};">›</view>
      </view>
    </bc-card>
    </view>

    <view class="mt-card">
    <bc-card theme="{{theme}}">
      <view class="settings-row" bindtap="goLanguage">
        <view class="settings-row__main">
          <view class="settings-row__title">{{entryLanguage}}</view>
          <view class="settings-row__value" style="color: {{theme.textTertiary}};">{{languageLabel}}</view>
        </view>
        <view class="settings-row__chev" style="color: {{theme.textTertiary}};">›</view>
      </view>
    </bc-card>
    </view>
  </scroll-view>
</view>
