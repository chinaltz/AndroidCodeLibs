.dictation-page {
  min-height: 100vh;
}

.dictation-stage {
  padding: 36rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.dictation-mascot {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto;
}

.dictation-mascot image {
  width: 100%;
  height: 100%;
}

.dictation-progress__label {
  margin-top: 12rpx;
  color: #173a62;
  font-size: 44rpx;
  font-weight: 900;
}

.dictation-progress {
  width: 100%;
  height: 24rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid #c8eaff;
  overflow: hidden;
  box-sizing: border-box;
}

.dictation-progress__fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #31a8ff 0%, #43cfc7 100%);
  transition: width 0.25s ease;
}

.dictation-status {
  min-height: 142rpx;
  margin-top: 30rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid #d8eef8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(23, 58, 98, 0.08);
}

.dictation-status.is-playing {
  border-color: #43cfc7;
  background: #effefa;
}

.dictation-status__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eaf6ff;
  color: #1479d6;
  font-size: 30rpx;
  line-height: 64rpx;
  flex: 0 0 auto;
}

.dictation-status__text {
  color: #173a62;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.4;
}

.dictation-error {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #fff6d3;
  color: #8f5300;
  font-size: 24rpx;
  line-height: 1.5;
}

.dictation-start,
.dictation-finish {
  height: 100rpx;
  margin-top: 34rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #4db8ff 0%, #1479d6 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 100rpx;
  box-shadow: inset 0 -6rpx 0 rgba(0, 75, 145, 0.18), 0 14rpx 28rpx rgba(20, 121, 214, 0.24);
}

.dictation-start.is-pressed,
.dictation-finish.is-pressed {
  transform: scale(0.98);
}

.dictation-controls {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 34rpx;
}

.dictation-control {
  min-height: 150rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid #c8eaff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(23, 58, 98, 0.08);
}

.dictation-control.is-disabled {
  opacity: 0.35;
}

.dictation-control__icon {
  color: #1479d6;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.dictation-control__text {
  margin-top: 12rpx;
  color: #173a62;
  font-size: 24rpx;
  font-weight: 900;
}

.dictation-secondary {
  height: 82rpx;
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid #d8eef8;
  color: #365d82;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.dictation-finish {
  margin-top: 18rpx;
  background: linear-gradient(180deg, #ffb347 0%, #ff7a18 100%);
  box-shadow: inset 0 -6rpx 0 rgba(143, 83, 0, 0.18), 0 14rpx 28rpx rgba(255, 122, 24, 0.24);
}
