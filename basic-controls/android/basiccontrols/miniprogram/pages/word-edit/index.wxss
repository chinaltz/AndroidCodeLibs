.input-panel,
.saved-panel {
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid #D8EEF8;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 32rpx rgba(23, 58, 98, 0.09);
}

.saved-panel {
  margin-top: 18rpx;
}

.panel-title {
  font-size: 32rpx;
  color: #173A62;
  font-weight: 900;
}

.panel-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #7895AE;
}

.batch-input {
  width: 100%;
  min-height: 150rpx;
  border-radius: 22rpx;
  border: 2rpx solid #C8EAFF;
  background: #F8FEFF;
  padding: 20rpx 22rpx;
  margin-top: 18rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.cp-char {
  width: 80rpx;
  height: 92rpx;
  border: 3rpx solid #C8D6DF;
  border-radius: 18rpx;
  background: #EEF2F5;
  color: #7895AE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
}

.cp-char.in-queue {
  border-color: #3288E6;
  background: #EAF4FF;
  color: #2468A8;
}

.cp-char.is-saved {
  border-color: #C8D6DF;
  background: #F0F2F4;
  color: #B0BCC5;
}

.judge-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.judge-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 4rpx;
  border-bottom: 2rpx solid rgba(200, 220, 234, 0.6);
}

.judge-item:last-child {
  border-bottom: 0;
}

.ji-char {
  width: 72rpx;
  height: 72rpx;
  border: 3rpx solid #C8D6DF;
  border-radius: 18rpx;
  background: #EEF2F5;
  color: #7895AE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.ji-char.is-known {
  border-color: #43CFC7;
  background: #E8FDF7;
  color: #0C8F7E;
}

.ji-char.is-unknown {
  border-color: #F45B69;
  background: #FFE8EA;
  color: #A92F3A;
}

.ji-btns {
  display: flex;
  gap: 10rpx;
  flex: 1;
}

.ji-btn {
  flex: 1;
  min-height: 58rpx;
  border-radius: 16rpx;
  border: 2rpx solid #C8EAFF;
  background: #FFFFFF;
  color: #7895AE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.ji-btn--danger {
  border-color: #F8C8CB;
  color: #C0616B;
  background: #FFF4F5;
}

.ji-btn--active-known {
  border-color: #43CFC7;
  background: #E8FDF7;
  color: #0C8F7E;
}

.ji-btn--active-unknown {
  border-color: #F45B69;
  background: #FFE8EA;
  color: #A92F3A;
}

.ji-save-row {
  height: 82rpx;
  border-radius: 22rpx;
  background: #0C8F7E;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 900;
}

.selection-hint {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #FFF3E4;
  color: #8F5300;
  font-size: 22rpx;
  line-height: 1.5;
}

.saved-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.saved-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.saved-count {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #E8FDF7;
  color: #0C8F7E;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 900;
}

.saved-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.saved-word {
  min-height: 112rpx;
  border-radius: 24rpx;
  border: 3rpx solid transparent;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
}

.saved-word.color-0 {
  border-color: #43CFC7;
  background: #E8FDF7;
}

.saved-word.color-1 {
  border-color: #7BB7FF;
  background: #EAF4FF;
}

.saved-word.color-2 {
  border-color: #FFB66D;
  background: #FFF3E4;
}

.saved-word.color-3 {
  border-color: #B7A4FF;
  background: #F1EDFF;
}

.saved-word-text {
  min-width: 110rpx;
  color: #173A62;
  font-size: 36rpx;
  font-weight: 900;
}

.saved-word-main {
  flex: 1;
  min-width: 0;
}

.saved-word-pinyin {
  color: #173A62;
  font-size: 25rpx;
  font-weight: 800;
}

.saved-word-source {
  margin-top: 6rpx;
  color: #7895AE;
  font-size: 21rpx;
}

.saved-word-relation {
  margin-top: 6rpx;
  color: #A92F3A;
  font-size: 21rpx;
  font-weight: 800;
}

.saved-state {
  color: #0C8F7E;
  font-size: 22rpx;
  font-weight: 900;
}

.empty-hint {
  min-height: 150rpx;
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: #F1F4F6;
  color: #9AA7B2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
