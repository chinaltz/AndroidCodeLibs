<view class="page-shell" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <bc-top-bar title="手动录入错字" show-back="{{true}}" bg-color="{{theme.pageStart || '#DDF4FF'}}" theme="{{theme}}" bind:back="onBack" />

  <scroll-view scroll-y class="page-body page-scroll">
    <bc-card theme="{{theme}}">
      <view class="panel-title">批量输入词语</view>
      <view class="panel-desc">选择词语中的每个字并标记“会 / 不会”，不会的字将保存到错字库。</view>
      <view
        class="batch-input-picker"
        style="background: {{theme.surfaceRaised}}; border-color: {{theme.borderDefault}};"
        bindtap="openBatchEditor"
      >
        <view class="batch-input-value {{batchText ? '' : 'is-placeholder'}}">
          {{batchText || '点击输入词语，例如：时候、游泳、慢慢'}}
        </view>
        <view class="batch-input-action" style="color: {{theme.brandPrimary}};">{{batchText ? '修改' : '输入'}}</view>
      </view>

      <view wx:if="{{charPool.length}}" class="char-pool">
        <view
          wx:for="{{charPool}}"
          wx:key="id"
          class="cp-char {{item.inQueue ? 'in-queue' : ''}} {{item.saved ? 'is-saved' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCharTap"
        >{{item.char}}</view>
      </view>

      <view wx:if="{{judgeList.length}}" class="judge-list">
        <view wx:for="{{judgeList}}" wx:key="id" class="judge-item">
          <view class="ji-char {{item.status === 'known' ? 'is-known' : ''}} {{item.status === 'unknown' ? 'is-unknown' : ''}}">{{item.char}}</view>
          <view class="ji-btns">
            <bc-choice-chip
              text="会"
              selected="{{item.status === 'known'}}"
              theme="{{theme}}"
              data-id="{{item.id}}"
              data-judge="known"
              bind:tap="onJudgeTap"
            />
            <bc-choice-chip
              text="不会"
              selected="{{item.status === 'unknown'}}"
              danger="{{true}}"
              theme="{{theme}}"
              data-id="{{item.id}}"
              data-judge="unknown"
              bind:tap="onJudgeTap"
            />
          </view>
        </view>

        <view wx:if="{{!selectionComplete}}" class="selection-hint">请把当前词的所有字都点到下方，再逐字选择“会 / 不会”。</view>
        <view wx:if="{{allDecided}}" class="ji-save-row">
          <bc-button text="保存到错字库" variant="primary" block="{{true}}" theme="{{theme}}" bind:tap="onSave" />
        </view>
      </view>
    </bc-card>

    <view class="saved-panel">
      <bc-card theme="{{theme}}">
        <view class="saved-head">
          <view>
            <view class="panel-title">本次已录入错字</view>
            <view class="panel-desc">错字已长期保存，可在“全部错字”中管理。</view>
          </view>
          <bc-chip text="{{savedEntries.length}} 组" variant="success" theme="{{theme}}" />
        </view>

        <view wx:if="{{savedEntries.length}}" class="saved-list">
          <view wx:for="{{savedEntries}}" wx:key="id" class="saved-word color-0">
            <view class="saved-word-text">{{item.word}}</view>
            <view class="saved-word-main">
              <view class="saved-word-pinyin">已保存错字</view>
              <view class="saved-word-relation">{{item.chars}}</view>
            </view>
          </view>
        </view>
        <view wx:else class="empty-hint">还没有保存错字。</view>
      </bc-card>
    </view>
    <view class="word-edit-safe-bottom"></view>
  </scroll-view>
</view>
