<view class="page-shell" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <bc-top-bar title="批量录入" show-back="{{true}}" bg-color="{{theme.pageStart}}" theme="{{theme}}" bind:back="onBack" />

  <scroll-view scroll-y class="page-body page-scroll">
    <view class="input-panel">
      <view class="panel-title">批量输入听写词</view>
      <view class="panel-desc">多个词用空格、逗号或顿号分开，所有字自动平铺。</view>
      <textarea class="batch-input" value="{{batchText}}" placeholder="例如：时候、游泳、慢慢" maxlength="200" bindinput="onBatchInput" />

      <view wx:if="{{charPool.length}}" class="char-pool">
        <view
          wx:for="{{charPool}}"
          wx:key="id"
          class="cp-char {{item.inQueue ? 'in-queue' : ''}} {{item.saved ? 'is-saved' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCharTap"
        >{{item.char}}</view>
      </view>

      <view wx:if="{{judgeList.length}}" class="judge-list">
        <view wx:for="{{judgeList}}" wx:key="id" class="judge-item">
          <view class="ji-char {{item.status === 'known' ? 'is-known' : ''}} {{item.status === 'unknown' ? 'is-unknown' : ''}}">{{item.char}}</view>
          <view class="ji-btns">
            <view
              class="ji-btn {{item.status === 'known' ? 'ji-btn--active-known' : ''}}"
              data-id="{{item.id}}"
              data-judge="known"
              bindtap="onJudgeTap"
            >会</view>
            <view
              class="ji-btn ji-btn--danger {{item.status === 'unknown' ? 'ji-btn--active-unknown' : ''}}"
              data-id="{{item.id}}"
              data-judge="unknown"
              bindtap="onJudgeTap"
            >不会</view>
          </view>
        </view>

        <view wx:if="{{!selectionComplete}}" class="selection-hint">请把当前词的所有字都点到下方，再逐字选择“会 / 不会”。</view>
        <view wx:if="{{allDecided}}" class="ji-save-row" bindtap="onSave">保存</view>
      </view>
    </view>

    <view class="saved-panel">
      <view class="saved-head">
        <view>
          <view class="panel-title">已保存词汇</view>
          <view class="panel-desc">每个完整词保存一条；不会字显示关联关系。</view>
        </view>
        <view class="saved-count">{{savedWords.length}} 个</view>
      </view>

      <view wx:if="{{savedWords.length}}" class="saved-list">
        <view wx:for="{{savedWords}}" wx:key="id" class="saved-word {{item.colorClass}}">
          <view class="saved-word-text">{{item.text}}</view>
          <view class="saved-word-main">
            <view class="saved-word-pinyin">{{item.displayPinyin}}</view>
            <view class="saved-word-relation">{{item.relationLabel ? '关联不会字：' + item.relationLabel : '全部会写，仅听写'}}</view>
          </view>
          <view class="saved-state">已保存</view>
        </view>
      </view>
      <view wx:else class="empty-hint">还没有保存词汇。</view>
    </view>
  </scroll-view>
</view>
