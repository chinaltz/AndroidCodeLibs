@import '../../styles/words-page.wxss';

page {
  height: auto;
  min-height: 100vh;
}

.word-planet-page {
  height: auto;
  min-height: 100vh;
  overflow: visible;
}

.word-planet-body {
  height: auto;
  min-height: 0;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.word-planet-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
}

.hero-head {
  display: flex;
  align-items: flex-start;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.summary-cell {
  min-height: 118rpx;
  border-radius: 22rpx;
  border: 2rpx solid;
  padding: 16rpx;
  box-sizing: border-box;
}

.summary-number {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.3;
}

.quick-entry-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.quick-entry:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

.quick-entry {
  min-height: 120rpx;
  border-radius: 22rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  transition: transform 120ms ease;
}

.quick-entry--pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

.quick-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.quick-main {
  flex: 1;
  min-width: 0;
}

.quick-title {
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.quick-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.35;
}

.entry-arrow {
  font-size: 34rpx;
  line-height: 1;
  flex-shrink: 0;
}

.filter-scroll {
  width: 100%;
  margin-top: 20rpx;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 4rpx 6rpx;
  white-space: nowrap;
}

.character-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.character-card {
  min-height: 116rpx;
  border: 2rpx solid;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.character-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.character-main {
  flex: 1;
  min-width: 0;
}

.character-count {
  font-size: 23rpx;
  line-height: 1.3;
}

.character-related {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.character-empty {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 22rpx;
  border: 2rpx dashed;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.entry-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 4rpx 0;
  transition: opacity 120ms ease;
}

.entry-row--pressed {
  opacity: 0.88;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.entry-desc {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.4;
}

.entry-count {
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.words-scroll-safe-bottom {
  height: 20rpx;
}
