<view class="page-shell word-planet-page" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <bc-top-bar title="字词星球" show-back="{{true}}" bg-color="{{theme.pageStart || '#DDF4FF'}}" theme="{{theme}}" bind:back="onBack" />

  <view class="page-body word-planet-body">
    <bc-card theme="{{theme}}">
      <view class="hero-head">
        <view class="hero-main">
          <view class="hero-title" style="color: {{theme.textPrimary}};">错字积累</view>
          <view class="hero-subtitle" style="color: {{theme.textTertiary}};">听写词仅本次有效；批改和标记「不会」的字会长期积累。</view>
        </view>
      </view>
      <view class="summary-grid">
        <view class="summary-cell" style="background: {{theme.selectedFill}}; border-color: {{theme.borderDefault}};">
          <view class="summary-number" style="color: {{theme.brandPrimary}};">{{stats.pendingCount}}</view>
          <view class="summary-label" style="color: {{theme.textTertiary}};">在练错字</view>
        </view>
        <view class="summary-cell" style="background: {{theme.selectedFill}}; border-color: {{theme.borderDefault}};">
          <view class="summary-number" style="color: {{theme.textPrimary}};">{{stats.totalCount}}</view>
          <view class="summary-label" style="color: {{theme.textTertiary}};">累计错字</view>
        </view>
        <view class="summary-cell" style="background: {{theme.selectedFill}}; border-color: {{theme.borderDefault}};">
          <view class="summary-number" style="color: {{theme.textPrimary}};">{{stats.maxWrongCount}}</view>
          <view class="summary-label" style="color: {{theme.textTertiary}};">最高错次</view>
        </view>
      </view>
    </bc-card>

    <view class="words-section-gap" />

    <bc-card theme="{{theme}}">
      <view class="quick-entry-grid">
        <view
          class="quick-entry"
          hover-class="quick-entry--pressed"
          style="background: {{theme.selectedFill}}; border-color: {{theme.borderDefault}};"
          bindtap="goDictationList"
        >
          <view class="quick-icon" style="background: {{theme.surfaceRaised}}; color: {{theme.brandPrimary}};">定</view>
          <view class="quick-main">
            <view class="quick-title" style="color: {{theme.textPrimary}};">听写计划</view>
            <view class="quick-desc" style="color: {{theme.textTertiary}};">家长设置今日内容 · {{dictationPlanCount}} 词</view>
          </view>
          <view class="entry-arrow" style="color: {{theme.textTertiary}};">›</view>
        </view>
        <view
          class="quick-entry"
          hover-class="quick-entry--pressed"
          style="background: {{theme.activeFill}}; border-color: {{theme.borderDefault}};"
          bindtap="goStartDictation"
        >
          <view class="quick-icon" style="background: {{theme.surfaceRaised}}; color: {{theme.brandDark}};">听</view>
          <view class="quick-main">
            <view class="quick-title" style="color: {{theme.textPrimary}};">开始听写</view>
            <view class="quick-desc" style="color: {{theme.textTertiary}};">孩子直接开始，只显示进度</view>
          </view>
          <view class="entry-arrow" style="color: {{theme.textTertiary}};">›</view>
        </view>
        <view
          class="quick-entry"
          hover-class="quick-entry--pressed"
          style="background: {{theme.surfaceRaised}}; border-color: {{theme.borderDefault}};"
          bindtap="goManualWrongEntry"
        >
          <view class="quick-icon" style="background: {{theme.selectedFill}}; color: {{theme.danger}};">错</view>
          <view class="quick-main">
            <view class="quick-title" style="color: {{theme.textPrimary}};">手动录入错字</view>
            <view class="quick-desc" style="color: {{theme.textTertiary}};">录入词语并标记不会的字</view>
          </view>
          <view class="entry-arrow" style="color: {{theme.textTertiary}};">›</view>
        </view>
      </view>
    </bc-card>

    <view class="words-section-gap" />

    <bc-card theme="{{theme}}">
      <view class="panel-head">
        <view class="panel-head-main">
          <view class="panel-title" style="color: {{theme.textPrimary}};">错字统计</view>
          <view class="panel-desc" style="color: {{theme.textTertiary}};">{{filterDesc}}</view>
        </view>
        <bc-chip text="{{characters.length}} 字" bg="{{theme.activeFill}}" color="{{theme.brandPrimary}}" />
      </view>

      <scroll-view scroll-x class="filter-scroll" enable-flex enhanced show-scrollbar="{{false}}">
        <view class="filter-row">
          <bc-choice-chip
            wx:for="{{filterTabs}}"
            wx:key="id"
            text="{{item.label}}"
            count="{{item.count}}"
            selected="{{activeFilter === item.id}}"
            theme="{{theme}}"
            data-filter="{{item.id}}"
            bind:tap="onFilterTap"
          />
        </view>
      </scroll-view>

      <view wx:if="{{characters.length}}" class="character-grid">
        <view
          wx:for="{{characters}}"
          wx:key="id"
          class="character-card"
          style="background: {{theme.surfaceRaised}}; border-color: {{theme.borderDefault}};"
        >
          <view class="character-badge" style="background: {{theme.selectedFill}}; color: {{theme.danger}}; border-color: {{theme.borderDefault}};">{{item.text}}</view>
          <view class="character-main">
            <view class="character-count" style="color: {{theme.textSecondary}};">错 <text style="color: {{theme.danger}}; font-weight: 900;">{{item.wrongCount || 0}}</text> 次</view>
            <view class="character-related" style="color: {{theme.textTertiary}};">关联词：{{item.relatedWords}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="character-empty" style="color: {{theme.textTertiary}}; background: {{theme.selectedFill}}; border-color: {{theme.borderDefault}};">
        这个分类暂时没有错字。试试切换筛选，或去听写批改积累错字。
      </view>
    </bc-card>

    <view class="words-section-gap" />

    <bc-card theme="{{theme}}">
      <view class="entry-row" hover-class="entry-row--pressed" bindtap="goAllWords">
        <view class="entry-icon" style="background: {{theme.selectedFill}}; color: {{theme.success}};">字</view>
        <view class="entry-main">
          <view class="entry-title" style="color: {{theme.textPrimary}};">全部错字</view>
          <view class="entry-desc" style="color: {{theme.textTertiary}};">按时间或错次排序，选字听写</view>
        </view>
        <view class="entry-count" style="color: {{theme.brandPrimary}};">{{stats.totalCount}} 字</view>
        <view class="entry-arrow" style="color: {{theme.textTertiary}};">›</view>
      </view>
    </bc-card>
    <view class="words-scroll-safe-bottom"></view>
  </view>

  <view class="word-planet-footer">
    <bc-sticky-footer theme="{{theme}}">
      <view class="footer-actions footer-actions--single">
        <bc-button text="开始听写 · {{dictationPlanCount}} 词" variant="primary" block="{{true}}" theme="{{theme}}" bind:tap="goStartDictation" />
      </view>
    </bc-sticky-footer>
  </view>
</view>
