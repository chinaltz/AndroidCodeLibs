.panel-title {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.panel-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.batch-picker {
  min-height: 112rpx;
  margin-top: 18rpx;
  border: 2rpx solid;
  border-radius: 22rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.batch-value {
  flex: 1;
  min-width: 0;
  color: #173A62;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-all;
}

.batch-value.is-placeholder {
  color: #7895AE;
}

.batch-action {
  flex: 0 0 auto;
  font-size: 25rpx;
  font-weight: 800;
}

.char-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.char-item {
  width: 80rpx;
  height: 92rpx;
  border: 3rpx solid #C8D6DF;
  border-radius: 18rpx;
  background: #EEF2F5;
  color: #7895AE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
}

.char-item.is-selected {
  border-color: #31A8FF;
  background: #EAF4FF;
  color: #1479D6;
}

.char-item.is-saved {
  border-color: #43CFC7;
  background: #E8FDF7;
  color: #0C8F7E;
}

.selected-panel {
  margin-top: 22rpx;
  padding: 18rpx;
  border: 2rpx solid;
  border-radius: 22rpx;
}

.selected-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.selected-title {
  font-size: 26rpx;
  font-weight: 900;
}

.selected-tip {
  font-size: 20rpx;
}

.selected-sequence {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.selected-char {
  position: relative;
  min-width: 78rpx;
  min-height: 96rpx;
  padding: 12rpx 10rpx 8rpx;
  border: 2rpx solid;
  border-radius: 18rpx;
  box-sizing: border-box;
  text-align: center;
}

.selected-order {
  position: absolute;
  top: -10rpx;
  left: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #31A8FF;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 30rpx;
  box-sizing: border-box;
}

.selected-text {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.selected-word {
  margin-top: 4rpx;
  max-width: 110rpx;
  overflow: hidden;
  color: #7895AE;
  font-size: 18rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selection-hint {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #FFF3E4;
  color: #8F5300;
  font-size: 21rpx;
  line-height: 1.5;
}

.save-row {
  margin-top: 20rpx;
}

.section-gap {
  height: 20rpx;
}

.saved-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.saved-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.queue-list {
  margin-top: 20rpx;
}

.queue-item {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 2rpx solid;
}

.queue-item:last-child {
  border-bottom: 0;
}

.queue-word {
  min-width: 120rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.queue-main {
  flex: 1;
  min-width: 0;
}

.queue-pinyin {
  font-size: 24rpx;
  font-weight: 800;
}

.queue-source {
  margin-top: 4rpx;
  font-size: 21rpx;
}

.empty-hint {
  min-height: 130rpx;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #F1F4F6;
  font-size: 24rpx;
}

.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
