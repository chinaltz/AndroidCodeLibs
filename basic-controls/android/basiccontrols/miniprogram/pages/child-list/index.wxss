.child-card-wrap + .child-card-wrap {
  margin-top: 18rpx;
}

.child-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.child-avatar {
  width: 96rpx;
  height: 96rpx;
}

.child-main {
  flex: 1;
  min-width: 0;
}

.child-name {
  font-size: 32rpx;
  font-weight: 900;
}

.child-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.child-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.empty-state {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 900;
}

.empty-desc {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: #7895AE;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-action {
  width: 320rpx;
  margin-top: 28rpx;
}
