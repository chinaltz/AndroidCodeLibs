.pomo-scroll {
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

.page-safe {
  height: 48rpx;
}

/* ── 欢迎区 ── */
.pomo-hero {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  padding: 24rpx 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fff 0%, #f0f9ff 100%);
  border: 2rpx solid #c8eaff;
  box-shadow: 0 12rpx 32rpx rgba(49, 168, 255, 0.12);
}

.pomo-hero__mascot {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 auto;
}

.pomo-hero__mascot.is-running {
  animation: pomo-bounce 1.2s ease-in-out infinite;
}

.pomo-hero__copy {
  flex: 1;
  min-width: 0;
}

.pomo-hero__title {
  font-size: 32rpx;
  font-weight: 900;
  color: #173a62;
}

.pomo-hero__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7a9bb8;
  line-height: 1.5;
}

.pomo-mute {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eef8ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.pomo-mute.is-pressed,
.pomo-preset.is-pressed,
.pomo-btn.is-pressed {
  transform: scale(0.96);
}

.pomo-mute image {
  width: 36rpx;
  height: 36rpx;
}

.pomo-mute.is-muted {
  background: #fff1f1;
}

.pomo-mute.is-muted image {
  opacity: 0.55;
}

.pomo-mute__slash {
  position: absolute;
  width: 42rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #e45b65;
  transform: rotate(-45deg);
}

/* ── 罗盘表盘 ── */
.compass-wrap {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.compass {
  position: relative;
  width: 580rpx;
  height: 580rpx;
}

.compass.is-running {
  animation: pomo-glow 2.2s ease-in-out infinite;
}

.compass.is-locked .compass-ring {
  opacity: 0.92;
}

.compass-pointer {
  position: absolute;
  left: 50%;
  top: -8rpx;
  width: 72rpx;
  height: 96rpx;
  margin-left: -36rpx;
  z-index: 30;
  pointer-events: none;
}

.compass-progress {
  position: absolute;
  inset: 24rpx;
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
  transition: background 0.35s ease;
}

.compass-ring {
  position: absolute;
  inset: 0;
  z-index: 2;
  transition: transform 0.12s ease-out;
}

.compass.is-dragging .compass-ring {
  transition: none;
}

.compass.is-dragging {
  animation: none;
}

.compass.is-locked .compass-ring {
  transition: none;
}

.compass-ring__img {
  width: 100%;
  height: 100%;
}

.compass-knob {
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 80rpx;
  height: 80rpx;
  margin-left: -40rpx;
  filter: drop-shadow(0 8rpx 14rpx rgba(255, 122, 24, 0.28));
}

.compass-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 320rpx;
  height: 320rpx;
  margin-left: -160rpx;
  margin-top: -160rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.compass-center__face {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.compass-center__time {
  position: relative;
  z-index: 1;
  font-size: 76rpx;
  line-height: 1;
  font-weight: 900;
  color: #1479d6;
  font-family: 'Courier New', monospace;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(49, 168, 255, 0.18);
}

.compass-center__set {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 209, 102, 0.35);
  color: #173a62;
  font-size: 22rpx;
  font-weight: 800;
}

.compass-week {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.compass-week__item {
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  font-weight: 800;
  color: #a8c4dc;
  border-radius: 50%;
}

.compass-week__item.is-active {
  color: #173a62;
  background: #ffd166;
}

.compass-date {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #7a9bb8;
}

.compass-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7a9bb8;
  text-align: center;
}

/* ── 预设 ── */
.pomo-presets {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}

.pomo-preset {
  position: relative;
  padding: 20rpx 8rpx 16rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid #e4f5ff;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(22, 120, 189, 0.06);
  transition: transform 0.12s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.pomo-preset.is-active {
  background: linear-gradient(180deg, #eaf6ff 0%, #fff 100%);
  border-color: #31a8ff;
  box-shadow: 0 8rpx 24rpx rgba(49, 168, 255, 0.16);
}

.pomo-preset__time {
  font-size: 28rpx;
  font-weight: 900;
  color: #173a62;
}

.pomo-preset__label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #7a9bb8;
}

.pomo-preset__star {
  position: absolute;
  top: -8rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: #ffd166;
  border-radius: 50%;
  box-shadow: 0 4rpx 8rpx rgba(255, 209, 102, 0.5);
}

.pomo-mode {
  position: relative;
  display: flex;
  margin: 28rpx auto 0;
  width: 360rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #eef8ff;
  border: 2rpx solid #d9efff;
}

.pomo-mode__pill {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  width: calc(50% - 6rpx);
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(49, 168, 255, 0.12);
  transition: left 0.25s ease;
}

.pomo-mode__pill.is-left { left: 6rpx; }
.pomo-mode__pill.is-right { left: calc(50%); }

.pomo-mode__item {
  flex: 1;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #7a9bb8;
  position: relative;
  z-index: 1;
}

.pomo-mode__item.is-active {
  color: #1479d6;
}

.pomo-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.pomo-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.pomo-btn--ghost {
  flex: 0 0 160rpx;
  background: #fff;
  color: #365d82;
  border: 2rpx solid #d9efff;
}

.pomo-btn--primary {
  background: linear-gradient(180deg, #ffb347 0%, #ff9f43 45%, #ff7a18 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 24, 0.32);
}

.pomo-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #7a9bb8;
}

.pomo-alarm-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 58, 98, 0.45);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pomo-alarm {
  width: 620rpx;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #fff 0%, #fff7d7 100%);
  border: 4rpx solid #ffd166;
  box-shadow: 0 30rpx 80rpx rgba(255, 159, 67, 0.25);
  text-align: center;
}

.pomo-alarm__icon {
  width: 160rpx;
  height: 160rpx;
}

.pomo-alarm__title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #173a62;
}

.pomo-alarm__copy {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #7a9bb8;
}

.pomo-alarm__time {
  margin-top: 20rpx;
  font-size: 72rpx;
  font-weight: 900;
  color: #1479d6;
  font-family: 'Courier New', monospace;
}

.pomo-alarm__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.pomo-btn--alarm {
  flex: 1;
  height: 88rpx;
}

@keyframes pomo-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@keyframes pomo-glow {
  0%, 100% { filter: drop-shadow(0 0 0 rgba(49, 168, 255, 0)); }
  50% { filter: drop-shadow(0 0 16rpx rgba(49, 168, 255, 0.35)); }
}
