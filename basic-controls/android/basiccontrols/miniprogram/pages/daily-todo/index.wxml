<view class="page-shell todo-page" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <view class="todo-topbar" style="padding-top: {{statusBarHeight}}px; background: {{theme.pageStart || '#DDF4FF'}};">
    <view class="todo-topbar__row" style="height: {{navBarHeight}}px; padding-right: {{capsulePaddingRight}}px;">
      <view class="todo-topbar__back" catchtap="onBack">‹</view>
      <view class="todo-topbar__title">每日任务</view>
      <view class="todo-topbar__action" bindtap="toggleEditMode">{{editMode ? '完成' : '编辑'}}</view>
    </view>
  </view>

  <scroll-view scroll-y class="page-scroll todo-scroll" enhanced show-scrollbar="{{false}}">
    <!-- 今日英雄区 -->
    <view class="todo-hero">
      <view class="todo-hero__badge">
        <image class="todo-hero__badge-icon" src="/assets/kids-ui/star-filled.png" mode="aspectFit" />
        <text>今日小任务</text>
      </view>
      <view class="todo-hero__progress-row">
        <view class="todo-hero__progress">已完成 {{doneCount}} / {{totalCount}}</view>
        <view class="todo-hero__reset" bindtap="onResetTasks">全部重置</view>
      </view>
      <view class="todo-stars">
        <image
          wx:for="{{stars}}"
          wx:key="index"
          class="todo-star"
          src="{{item.filled ? '/assets/kids-ui/star-filled.png' : '/assets/kids-ui/star-empty.png'}}"
          mode="aspectFit"
          lazy-load
        />
      </view>
      <view class="todo-hero__note">明天还会看到同样的任务哦</view>
    </view>

    <!-- 任务卡片 -->
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="todo-card {{item.done ? 'is-done' : ''}} {{editMode ? 'is-editing' : ''}}"
    >
      <view
        wx:if="{{editMode}}"
        class="todo-card__drag"
        data-index="{{index}}"
      >
        <view class="todo-order">
          <view class="todo-order__btn {{index === 0 ? 'is-disabled' : ''}}" data-index="{{index}}" data-dir="-1" catchtap="onMoveItem">↑</view>
          <view class="todo-order__btn {{index === items.length - 1 ? 'is-disabled' : ''}}" data-index="{{index}}" data-dir="1" catchtap="onMoveItem">↓</view>
        </view>
      </view>

      <view class="todo-card__badge {{item.done ? 'is-done' : ''}}">
        {{item.done ? '✓' : item.indexLabel}}
      </view>

      <view class="todo-card__main" data-id="{{item.id}}" bindtap="openEdit">
        <view class="todo-card__title">{{item.title}}</view>
        <view wx:if="{{item.presetMinutes}}" class="todo-card__meta">大概 {{item.presetMinutes}} 分钟</view>
      </view>

      <view wx:if="{{!editMode}}" class="todo-complete-btn {{item.done ? 'is-done' : ''}}" data-id="{{item.id}}" bindtap="onToggleTask">
        {{item.done ? '已完成' : '完成'}}
      </view>

      <view wx:if="{{editMode}}" class="todo-card__edit" data-id="{{item.id}}" catchtap="openEdit">改</view>
      <view wx:if="{{editMode}}" class="todo-card__delete" data-id="{{item.id}}" catchtap="onDeleteItem">×</view>
    </view>

    <view wx:if="{{!items.length}}" class="todo-empty">
      <view class="todo-empty__emoji">📝</view>
      <view class="todo-empty__title">还没有任务呢</view>
      <view class="todo-empty__copy">点下面按钮，加一个吧～</view>
    </view>

    <view class="todo-tip">{{editMode ? '编辑模式：用上下箭头换顺序，点“改”修改内容。' : '点右侧完成按钮记录进度，点右上角编辑任务。'}}</view>
    <view class="page-safe"></view>
  </scroll-view>

  <!-- 底部大按钮 -->
  <view wx:if="{{editMode}}" class="page-action todo-footer">
    <view class="todo-add-btn" hover-class="is-pressed" bindtap="openAddSheet">＋ 加一个任务</view>
  </view>

  <!-- 添加 -->
  <view wx:if="{{showAddSheet}}" class="sheet-mask" bindtap="closeAddSheet"></view>
  <view wx:if="{{showAddSheet}}" class="todo-sheet is-open">
    <view class="sheet-handle"></view>
    <view class="sheet-title">加一个任务</view>
    <input class="sheet-input" placeholder="比如：英语打卡" value="{{newTitle}}" bindinput="onNewTitleInput" />
    <picker mode="selector" range="{{presetMinutes}}" value="{{presetMinutes.indexOf(newMinutes)}}" bindchange="onNewMinutesChange">
      <view class="sheet-picker">大概要做：{{newMinutes}} 分钟</view>
    </picker>
    <view class="sheet-actions">
      <bc-button text="取消" variant="default" theme="{{theme}}" catch:tap="closeAddSheet" />
      <bc-button text="保存" variant="primary" theme="{{theme}}" catch:tap="confirmAdd" />
    </view>
  </view>

  <!-- 编辑 -->
  <view wx:if="{{editingId}}" class="sheet-mask" bindtap="closeEdit"></view>
  <view wx:if="{{editingId}}" class="todo-sheet is-open">
    <view class="sheet-handle"></view>
    <view class="sheet-title">改一下任务</view>
    <input class="sheet-input" value="{{editTitle}}" bindinput="onEditTitleInput" />
    <picker mode="selector" range="{{presetMinutes}}" value="{{presetMinutes.indexOf(editMinutes)}}" bindchange="onEditMinutesChange">
      <view class="sheet-picker">大概要做：{{editMinutes}} 分钟</view>
    </picker>
    <view class="sheet-actions">
      <bc-button text="取消" variant="default" theme="{{theme}}" catch:tap="closeEdit" />
      <bc-button text="保存" variant="primary" theme="{{theme}}" catch:tap="confirmEdit" />
    </view>
  </view>
</view>
