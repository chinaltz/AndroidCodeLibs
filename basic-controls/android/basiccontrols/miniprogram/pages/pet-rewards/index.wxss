.reward-hero { display: flex; align-items: center; gap: 20rpx; margin-bottom: 18rpx; padding: 22rpx; border-radius: 32rpx; background: linear-gradient(145deg,#fff4bd,#c9f7e9 55%,#b9e1ff); }.reward-hero image { width: 210rpx; height: 230rpx; border-radius: 28rpx; }.reward-big { margin-bottom: 8rpx; color: #a36500; font-size: 38rpx; font-weight: 900; }.share-button { min-height: 64rpx; margin: 0; padding: 0 16rpx; border: 0; border-radius: 18rpx; background: #087f74; color: #fff; font-size: 21rpx; font-weight: 900; line-height: 64rpx; }.share-button::after { border: 0; }.share-rule { padding: 14rpx; border-radius: 16rpx; background: #f3f7f9; color: #718da8; font-size: 20rpx; line-height: 1.5; }.ledger-delta { color: #a36500; font-weight: 900; }
