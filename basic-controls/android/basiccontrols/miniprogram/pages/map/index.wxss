page {
  height: auto;
  min-height: 100%;
  overflow-y: auto;
}

.home-logo--image {
  background: transparent;
  box-shadow: none;
  border-radius: 18rpx;
}

.map-page {
  box-sizing: border-box;
}

.map-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  box-sizing: border-box;
  width: 100%;
  box-shadow: 0 10rpx 28rpx rgba(23, 58, 98, 0.08);
}

.map-body {
  padding-left: 16rpx;
  padding-right: 16rpx;
  box-sizing: border-box;
}

.map-body > .onboard-hero,
.map-body > .adventure-hero {
  margin-top: 24rpx;
}

.map-body--onboard {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.map-body--tab {
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.child-chip,
.child-switch,
.quest-card {
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.child-chip.is-pressed,
.child-switch.is-pressed,
.quest-card.is-pressed {
  opacity: 0.86;
  transform: scale(0.98);
}

.map-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
}

.onboard-form-card {
  margin-top: 20rpx;
}

.onboard-hero {
  position: relative;
  min-height: 300rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FFF5C7 0%, #BDF4EA 58%, #A9D9FF 100%);
  overflow: hidden;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 48rpx rgba(23, 58, 98, 0.14);
}

.onboard-copy {
  width: 58%;
  position: relative;
  z-index: 2;
}

.onboard-title {
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 900;
}

.onboard-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.onboard-planet {
  position: absolute;
  right: -8rpx;
  bottom: -18rpx;
  width: 260rpx;
  height: 260rpx;
}

.onboard-section-title {
  font-size: 30rpx;
  font-weight: 900;
}

.onboard-form-section {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid rgba(120, 149, 174, 0.16);
}

.onboard-nickname-input {
  width: 100%;
  min-height: 82rpx;
  margin-top: 12rpx;
  border: 2rpx solid;
  border-radius: 22rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.onboard-section-desc {
  margin-top: 8rpx;
  color: #7895AE;
  font-size: 22rpx;
  line-height: 1.5;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 18rpx;
}

.avatar-option {
  border-width: 2rpx;
  border-style: solid;
  border-radius: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.avatar-option.is-selected {
  box-shadow: 0 10rpx 24rpx rgba(23, 58, 98, 0.08);
}

.avatar-card {
  min-height: 330rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.avatar-image {
  width: 210rpx;
  height: 210rpx;
}

.avatar-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.nickname-panel {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 36rpx rgba(23, 58, 98, 0.12);
}

.step-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(120, 149, 174, 0.35);
}

.step-dot.is-active {
  width: 36rpx;
  border-radius: 999rpx;
  background: #43CFC7;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}

.color-card {
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.onboard-module-icon {
  width: 72rpx;
  height: 72rpx;
}

.color-swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.65);
}

.color-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.onboard-actions {
  margin-top: 28rpx;
}

.onboard-actions--split {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.nickname-input {
  min-height: 88rpx;
  border-radius: 22rpx;
  border: 2rpx solid #C8EAFF;
  background: #FFFFFF;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.adventure-hero {
  position: relative;
  min-height: 430rpx;
  border-radius: 40rpx;
  background: linear-gradient(140deg, #FFE893 0%, #65DCCF 50%, #66A7FF 100%);
  overflow: hidden;
  padding: 26rpx;
  box-sizing: border-box;
  box-shadow: 0 28rpx 58rpx rgba(23, 58, 98, 0.16);
}

.hero-background {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.hero-background--css {
  background: linear-gradient(135deg, #ffe893 0%, #8ee4c8 52%, #66a7ff 100%);
}

.hero-deco {
  position: absolute;
  pointer-events: none;
}

.hero-deco--cloud-a {
  top: 36rpx;
  right: -40rpx;
  width: 160rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: -36rpx 10rpx 0 rgba(255, 255, 255, 0.66), 36rpx 12rpx 0 rgba(255, 255, 255, 0.62);
  animation: hero-cloud-drift 16s linear infinite;
}

.hero-deco--cloud-b {
  top: 120rpx;
  right: -80rpx;
  width: 120rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: -28rpx 8rpx 0 rgba(255, 255, 255, 0.58);
  animation: hero-cloud-drift 22s linear infinite;
}

.hero-deco--pet {
  right: 24rpx;
  bottom: 8rpx;
  width: 180rpx;
  height: 180rpx;
  opacity: 0.92;
  animation: hero-pet-float 3.6s ease-in-out infinite;
}

@keyframes hero-cloud-drift {
  0% { transform: translateX(0); }
  100% { transform: translateX(-720rpx); }
}

@keyframes hero-pet-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.hero-top {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.child-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  max-width: 460rpx;
  min-height: 78rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  padding: 8rpx 16rpx 8rpx 8rpx;
  box-sizing: border-box;
}

.child-avatar {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
}

.child-copy {
  min-width: 0;
}

.child-name {
  font-size: 28rpx;
  font-weight: 900;
  color: #173A62;
}

.child-meta {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #416279;
}

.child-switch {
  height: 62rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #0C8F7E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.hero-copy {
  position: relative;
  z-index: 3;
  width: 55%;
  margin-top: 34rpx;
}

.hero-eyebrow {
  display: inline-flex;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #8F5300;
  align-items: center;
  font-size: 22rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 54rpx;
  line-height: 1.08;
  color: #173A62;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #416279;
}

.hero-kid {
  position: absolute;
  right: 34rpx;
  bottom: 10rpx;
  z-index: 2;
  width: 210rpx;
  height: 210rpx;
}

.hero-planet {
  position: absolute;
  z-index: 1;
}

.hero-planet-main {
  right: -48rpx;
  bottom: 70rpx;
  width: 260rpx;
  height: 260rpx;
}

.hero-planet-words {
  right: 210rpx;
  bottom: 22rpx;
  width: 118rpx;
  height: 118rpx;
}

.metrics-rail {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.metric-card {
  min-height: 118rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #D8EEF8;
  padding: 18rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(23, 58, 98, 0.08);
}

.metric-value {
  font-size: 34rpx;
  font-weight: 900;
  color: #173A62;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7895AE;
}

.section-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 2rpx 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
}

.section-action,
.section-note {
  font-size: 23rpx;
  color: #7895AE;
  font-weight: 800;
}

.quest-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.quest-grid--last {
  padding-bottom: 22rpx;
}

.quest-card {
  min-height: 176rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(242, 252, 255, 0.96) 58%, rgba(233, 252, 247, 0.96) 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  padding: 20rpx 22rpx 20rpx 166rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  box-shadow:
    inset 0 -6rpx 0 rgba(20, 121, 214, 0.08),
    0 14rpx 30rpx rgba(23, 58, 98, 0.12);
  display: flex;
  align-items: center;
}

.quest-card::before {
  content: '';
  position: absolute;
  left: -34rpx;
  top: -30rpx;
  width: 198rpx;
  height: 198rpx;
  border-radius: 42rpx;
  background: linear-gradient(145deg, #FFE893 0%, #9AE8D1 100%);
  transform: rotate(8deg);
}

.quest-card::after {
  content: '';
  position: absolute;
  right: 24rpx;
  top: 22rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 232, 147, 0.4);
  box-shadow: 30rpx 54rpx 0 rgba(154, 232, 209, 0.34);
}

.quest-art {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  z-index: 2;
  width: 124rpx;
  height: 124rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -5rpx 0 rgba(23, 58, 98, 0.08);
}

.quest-image {
  width: 104rpx;
  height: 104rpx;
}

.quest-main {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  padding-right: 150rpx;
}

.quest-title {
  font-size: 30rpx;
  color: #173A62;
  font-weight: 900;
  line-height: 1.3;
}

.quest-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #7895AE;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.quest-play {
  position: absolute;
  right: 22rpx;
  bottom: 24rpx;
  z-index: 3;
  min-width: 86rpx;
  height: 52rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #43CFC7 0%, #0C9E8D 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
  box-shadow: inset 0 -4rpx 0 rgba(0, 92, 82, 0.18), 0 8rpx 18rpx rgba(12, 158, 141, 0.22);
}

.quest-play.is-plan {
  min-width: 140rpx;
  background: #FFFFFF;
  border: 2rpx solid #31A8FF;
  color: #1479D6;
  line-height: 48rpx;
  box-shadow: 0 8rpx 18rpx rgba(49, 168, 255, 0.14);
}

.quest-play.is-manage {
  min-width: 140rpx;
  background: #FFFFFF;
  border: 2rpx solid #FF8E9B;
  color: #C74757;
  line-height: 48rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 111, 128, 0.14);
}

.quest-play.is-parent {
  min-width: 104rpx;
  background: #173A62;
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(23, 58, 98, 0.2);
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 26, 46, 0.46);
  z-index: 200;
}

.switch-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 0 env(safe-area-inset-bottom, 24rpx);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.switch-sheet.is-open {
  transform: translateY(0);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #D8EEF8;
  margin: 18rpx auto 0;
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 900;
  color: #173A62;
  padding: 22rpx 32rpx 10rpx;
}

.sheet-list {
  padding: 8rpx 24rpx 0;
}

.sheet-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 108rpx;
  border-radius: 26rpx;
  padding: 0 24rpx;
  margin-bottom: 10rpx;
  background: #F5F9FC;
}

.sheet-item.is-current {
  background: #E8FDF7;
}

.sheet-avatar {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
}

.sheet-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 900;
  color: #173A62;
  min-width: 0;
}

.sheet-tag {
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #7895AE;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 900;
}

.sheet-item.is-current .sheet-tag {
  background: #0C8F7E;
  color: #FFFFFF;
}

.sheet-add {
  margin: 10rpx 24rpx 24rpx;
  height: 96rpx;
  border-radius: 26rpx;
  border: 3rpx dashed #C8EAFF;
  color: #43CFC7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}
