<view class="map-page" style="min-height: {{pageHeight}}px; background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <view class="map-header home-header" style="height: {{headerHeight}}px; padding-top: {{statusBarHeight}}px; background: {{theme.pageStart}};">
    <image class="home-logo home-logo--image" src="/assets/icons/app-learning.png" mode="aspectFit" />
    <view class="home-title">
      <view class="home-name" style="color: {{theme.textPrimary}};">学习星球</view>
      <view class="home-slogan" style="color: {{theme.textTertiary}};">{{childSubtitle}}</view>
    </view>
  </view>

  <view class="map-body map-body--tab">
    <block wx:if="{{child}}">
      <view class="adventure-hero">
        <view class="hero-background hero-background--css">
          <view class="hero-deco hero-deco--cloud-a"></view>
          <view class="hero-deco hero-deco--cloud-b"></view>
          <image class="hero-deco hero-deco--pet" src="/assets/icons/module-pet.png" mode="aspectFit" />
        </view>
        <view class="hero-top">
          <view class="child-chip" bindtap="goChildren">
            <image class="child-avatar" src="{{childAvatarPath}}" mode="aspectFit" />
            <view class="child-copy">
              <view class="child-name">{{child.nickname}}</view>
              <view class="child-meta">{{childrenCount}} 个本地档案</view>
            </view>
          </view>
          <view class="child-switch" bindtap="openSwitchSheet">切换</view>
        </view>
        <view class="hero-copy">
          <view class="hero-eyebrow">今日冒险</view>
          <view class="hero-title">完成今日学习任务</view>
          <view class="hero-subtitle">按已开启的学习模块完成今天的任务。</view>
        </view>
      </view>

      <view class="metrics-rail" style="grid-template-columns: repeat({{enabledModuleCount}}, 1fr);">
        <view wx:if="{{enabledModules.phonics}}" class="metric-card">
          <view class="metric-value">{{phonicsText}}</view>
          <view class="metric-label">音标进度</view>
        </view>
        <view wx:if="{{enabledModules.words}}" class="metric-card">
          <view class="metric-value">{{wordPendingCount}}</view>
          <view class="metric-label">错字待练</view>
        </view>
        <view wx:if="{{enabledModules.pinyin}}" class="metric-card">
          <view class="metric-value">{{pinyinText}}</view>
          <view class="metric-label">拼音进度</view>
        </view>
      </view>

      <view class="section-line">
        <view class="section-title" style="color: {{theme.textPrimary}};">当前任务</view>
      </view>
      <view class="quest-grid quest-grid--last">
        <view wx:for="{{todayQuests}}" wx:key="key" class="quest-card" data-path="{{item.path}}" bindtap="onQuestTap">
          <image class="quest-image" src="{{item.image}}" mode="aspectFit" />
          <view class="quest-main">
            <view class="quest-title">{{item.title}}</view>
            <view class="quest-desc">{{item.desc}}</view>
          </view>
          <view class="quest-play">
            <bc-button
              text="开始"
              size="compact"
              variant="primary"
              theme="{{theme}}"
              data-path="{{item.path}}"
              catch:tap="onQuestTap"
            />
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{child}}" class="map-tabbar">
    <bc-bottom-tab tabs="{{tabs}}" selected="{{0}}" theme="{{theme}}" bind:change="onTabChange" />
  </view>

  <view wx:if="{{showSwitchSheet}}" class="sheet-mask" bindtap="closeSwitchSheet"></view>
  <view wx:if="{{showSwitchSheet}}" class="switch-sheet is-open">
    <view class="sheet-handle"></view>
    <view class="sheet-title">切换孩子</view>
    <view class="sheet-list">
      <view
        wx:for="{{sheetChildren}}"
        wx:key="id"
        class="sheet-item {{item.isCurrent ? 'is-current' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSheetSwitchChild"
      >
        <image class="sheet-avatar" src="{{item.avatarPath}}" mode="aspectFit" />
        <view class="sheet-name">{{item.nickname}}</view>
        <view class="sheet-tag">{{item.isCurrent ? '当前' : '切换'}}</view>
      </view>
    </view>
    <view class="sheet-add" bindtap="onSheetAddChild">+ 添加孩子</view>
  </view>
</view>
