<view class="page-shell" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <view class="home-header" style="height: {{headerHeight}}px; padding-top: {{statusBarHeight}}px; background: {{theme.pageStart}};">
    <view class="home-logo">☺</view>
    <view class="home-title">
      <view class="home-name" style="color: {{theme.textPrimary}};">{{i18n.appName}}</view>
      <view class="home-slogan" style="color: {{theme.textTertiary}};">{{i18n.appSlogan}}</view>
    </view>
  </view>

  <scroll-view scroll-y class="page-body page-scroll">
    <bc-card theme="{{theme}}">
      <view style="display:flex;align-items:center;">
        <view style="flex:1;font-size:30rpx;font-weight:700;">{{progressText}}</view>
        <bc-chip text="{{percentText}}" bg="{{theme.warning}}" color="{{theme.textPrimary}}" />
      </view>
      <view class="mt-sm"><bc-progress value="{{progressRatio}}" theme="{{theme}}" /></view>
      <view class="mt-sm" style="font-size:26rpx;color:{{theme.textTertiary}};">{{i18n.hint}}</view>
    </bc-card>

    <block wx:for="{{groups}}" wx:key="title">
      <view class="group-card">
      <bc-card theme="{{theme}}">
        <view class="group-head">
          <view class="group-title">{{item.title}}</view>
          <bc-chip text="{{item.items.length}} 关" bg="#E5F6FF" color="{{theme.brandDark}}" />
        </view>
        <view class="phoneme-grid">
          <view
            wx:for="{{item.items}}"
            wx:for-item="cell"
            wx:key="id"
            class="phoneme-cell"
            style="background: {{cellStyleMap[cell.id].bg}}; border-color: {{cellStyleMap[cell.id].border}}; color: {{theme.textPrimary}};"
            data-id="{{cell.id}}"
            bindtap="onPhonemeTap"
          >{{cell.symbol}}</view>
        </view>
      </bc-card>
      </view>
    </block>
  </scroll-view>

  <view class="page-action">
    <bc-button text="{{startText}}" variant="primary" theme="{{theme}}" bind:tap="onStartLearn" />
  </view>

  <bc-bottom-tab tabs="{{tabs}}" selected="{{0}}" theme="{{theme}}" bind:change="onTabChange" />
</view>
