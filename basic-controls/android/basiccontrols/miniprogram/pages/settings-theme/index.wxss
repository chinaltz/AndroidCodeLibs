.color-hint {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.color-hint--child {
  margin-bottom: 24rpx;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding-bottom: 24rpx;
}

.color-card {
  min-height: 196rpx;
  border-radius: 28rpx;
  border: 4rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 14rpx 28rpx rgba(23, 58, 98, 0.08);
}

.color-swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.65);
}

.color-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.color-check {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
}
