page {
  height: auto;
}

.children-page {
  height: auto;
  overflow: visible;
}

.children-body {
  height: auto;
  min-height: 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.children-card {
  border: 2rpx solid;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 58, 98, 0.06);
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.form-section + .form-section {
  margin-top: 34rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(120, 149, 174, 0.16);
}

.avatar-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.avatar-option {
  border-width: 2rpx;
  border-style: solid;
  border-radius: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.avatar-option.is-selected {
  box-shadow: 0 10rpx 24rpx rgba(23, 58, 98, 0.08);
}

.avatar-pick {
  min-height: 230rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  pointer-events: none;
}

.avatar-pick image {
  width: 160rpx;
  height: 160rpx;
}

.nickname-picker {
  min-height: 88rpx;
  border-radius: 22rpx;
  border: 2rpx solid #C8EAFF;
  background: #FFFFFF;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.nickname-value {
  flex: 1;
  min-width: 0;
}

.nickname-edit {
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.privacy {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.save-action {
  margin-top: 32rpx;
}

.save-button {
  width: 100%;
  height: 88rpx;
  border: 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  padding: 0;
}

.save-button::after {
  border: 0;
}

.step-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(120, 149, 174, 0.35);
}

.step-dot.is-active {
  width: 36rpx;
  border-radius: 999rpx;
  background: #43CFC7;
}

.step-copy {
  margin-bottom: 18rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.color-card {
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.color-swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.65);
}

.color-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.module-card {
  position: relative;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
}

.module-icon {
  width: 72rpx;
  height: 72rpx;
}

.module-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.module-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
}

.module-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(120, 149, 174, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.module-check.is-checked {
  background: #43CFC7;
}

.onboard-actions {
  margin-top: 8rpx;
}

.onboard-actions--split {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.child-row {
  min-height: 128rpx;
  border-radius: 28rpx;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(23, 58, 98, 0.09);
}

.child-row-avatar {
  width: 86rpx;
  height: 86rpx;
}

.child-row-main {
  flex: 1;
  min-width: 0;
}

.child-row-name {
  font-size: 32rpx;
  font-weight: 900;
}

.child-row-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.switch-tag {
  min-width: 76rpx;
  height: 44rpx;
  border-radius: 999rpx;
  border: 2rpx solid #C8EAFF;
  background: #FFFFFF;
  color: #1479D6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.switch-tag.is-current {
  border-color: transparent;
  background: #E8FDF7;
  color: #0C8F7E;
}
