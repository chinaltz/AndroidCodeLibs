<view class="page-shell" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <bc-top-bar title="今日听写计划" show-back="{{true}}" bg-color="{{theme.pageStart || '#DDF4FF'}}" theme="{{theme}}" bind:back="onBack" />

  <scroll-view scroll-y class="page-body page-scroll words-page-scroll">
    <bc-card theme="{{theme}}">
      <view class="panel-head">
        <view class="panel-head-main">
          <view class="panel-title" style="color: {{theme.textPrimary}};">今日安排 · {{count}} 个词</view>
          <view class="panel-desc" style="color: {{theme.textTertiary}};">家长在这里设置今天要听写的内容，孩子开始后不会看到答案。</view>
        </view>
        <bc-chip text="{{count}}" bg="{{theme.activeFill}}" color="{{theme.brandPrimary}}" />
      </view>

      <view wx:if="{{queue.length}}" class="queue-list">
        <view
          wx:for="{{queue}}"
          wx:key="id"
          class="queue-item"
          style="border-color: {{theme.borderDefault}};"
        >
          <view class="qi-badge" style="background: {{theme.selectedFill}}; border-color: {{theme.borderDefault}}; color: {{theme.textPrimary}};">{{item.text}}</view>
          <view class="qi-main">
            <view class="qi-pinyin" style="color: {{theme.textSecondary}};">{{item.pinyin}}</view>
            <view class="qi-source" style="color: {{theme.textTertiary}};">{{item.sourceLabel}}</view>
          </view>
          <bc-choice-chip text="删除" danger="{{true}}" theme="{{theme}}" data-id="{{item.id}}" bind:tap="onDelete" />
        </view>
      </view>
      <view wx:else class="empty-hint" style="color: {{theme.textTertiary}}; background: {{theme.selectedFill}}; border-color: {{theme.borderDefault}};">
        今天还没有安排听写内容，请从下方添加。
      </view>

      <view class="add-row">
        <bc-choice-chip text="课本" theme="{{theme}}" bind:tap="goAddFromTextbook" />
        <bc-choice-chip text="错字" theme="{{theme}}" bind:tap="goAddFromWrongChars" />
        <bc-choice-chip text="手动录入" theme="{{theme}}" bind:tap="goAddManual" />
      </view>
    </bc-card>

    <view class="words-section-gap" />

    <bc-card theme="{{theme}}">
      <view class="plan-setting-title" style="color: {{theme.textPrimary}};">播放设置</view>
      <view class="plan-setting-row">
        <view><view class="plan-setting-label">每个内容重复</view><view class="plan-setting-desc">播放完设定次数后停下等待</view></view>
        <picker mode="selector" range="{{repeatOptions}}" value="{{repeatOptions.indexOf(repeatCount)}}" bindchange="onRepeatChange"><view class="plan-setting-value">{{repeatCount}} 次 ›</view></picker>
      </view>
      <view class="plan-setting-row">
        <view><view class="plan-setting-label">重复间隔</view><view class="plan-setting-desc">两次自动播放之间的等待时间</view></view>
        <picker mode="selector" range="{{intervalOptions}}" value="{{intervalOptions.indexOf(intervalSeconds)}}" bindchange="onIntervalChange"><view class="plan-setting-value">{{intervalSeconds}} 秒 ›</view></picker>
      </view>
      <view class="panel-desc plan-expire-note" style="color: {{theme.textTertiary}};">计划只保留到今天结束；删除或清空不会影响错字库。</view>
    </bc-card>
  </scroll-view>

  <bc-sticky-footer theme="{{theme}}">
    <view class="footer-actions">
      <bc-button
        text="完成设置"
        variant="primary"
        block="{{true}}"
        theme="{{theme}}"
        bind:tap="finishPlan"
      />
      <bc-button text="清空计划" variant="default" block="{{true}}" theme="{{theme}}" bind:tap="onClear" />
    </view>
  </bc-sticky-footer>
</view>
