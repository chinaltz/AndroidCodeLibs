@import '../../styles/words-page.wxss';

.toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 24rpx;
  border-bottom: 2rpx solid;
}

.search-input {
  flex: 1;
}

.sort-scroll {
  width: 100%;
  border-bottom: 2rpx solid;
}

.sort-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 12rpx 24rpx 16rpx;
  white-space: nowrap;
}

.word-list-scroll {
  padding-top: 8rpx;
}

.week-card {
  margin-top: 0;
}

.week-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.week-head-main {
  flex: 1;
  min-width: 0;
}

.week-title {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.week-count {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.week-word-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.week-word {
  min-height: 168rpx;
  padding: 18rpx;
  box-sizing: border-box;
  position: relative;
}

.word-check {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 13rpx;
  border: 2rpx solid #C8EAFF;
  background: #FFFFFF;
  color: #0C8F7E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.word-text {
  max-width: calc(100% - 42rpx);
  padding-top: 8rpx;
  font-size: 40rpx;
  font-weight: 900;
  word-break: break-all;
  line-height: 1.1;
}

.word-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.word-source {
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-state {
  min-height: 360rpx;
  border-radius: 28rpx;
  border: 2rpx dashed;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.dictation-dock {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.dock-actions {
  display: grid;
  grid-template-columns: 200rpx 1fr;
  gap: 14rpx;
  align-items: center;
}

.dock-main {
  min-width: 0;
}

.dock-count {
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.dock-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.35;
}
