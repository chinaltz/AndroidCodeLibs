.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 24rpx;
  background: rgba(255, 255, 255, 0.84);
}

.search-bar input {
  flex: 1;
  min-height: 76rpx;
  border-radius: 22rpx;
  border: 2rpx solid #C8EAFF;
  background: #FFFFFF;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 25rpx;
}

.clear-link {
  color: #0C8F7E;
  font-size: 23rpx;
  font-weight: 900;
}

.word-list-scroll {
  padding-bottom: 150rpx;
}

.week-section {
  margin-bottom: 22rpx;
}

.week-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.week-title {
  color: #173A62;
  font-size: 34rpx;
  font-weight: 900;
}

.week-count {
  margin-top: 4rpx;
  color: #7895AE;
  font-size: 22rpx;
}

.select-week {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 17rpx;
  background: #E8FDF7;
  color: #0C8F7E;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 900;
}

.week-word-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.week-word {
  min-height: 176rpx;
  border-radius: 26rpx;
  border: 3rpx solid #D8EEF8;
  background: rgba(255, 255, 255, 0.94);
  padding: 18rpx;
  box-sizing: border-box;
  position: relative;
  box-shadow: 0 12rpx 26rpx rgba(23, 58, 98, 0.08);
}

.week-word.is-selected {
  border-color: #43CFC7;
  background: #E8FDF7;
}

.word-check {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 13rpx;
  border: 2rpx solid #C8EAFF;
  background: #FFFFFF;
  color: #0C8F7E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.word-text {
  max-width: calc(100% - 42rpx);
  color: #173A62;
  font-size: 40rpx;
  font-weight: 900;
  word-break: break-all;
}

.word-pinyin {
  margin-top: 8rpx;
  color: #416279;
  font-size: 22rpx;
}

.word-source {
  margin-top: 12rpx;
  color: #7895AE;
  font-size: 20rpx;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-state {
  min-height: 420rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-title {
  color: #173A62;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  color: #7895AE;
  font-size: 23rpx;
}

.dictation-dock {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  min-height: 100rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 48rpx rgba(23, 58, 98, 0.18);
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 16rpx 14rpx 22rpx;
  box-sizing: border-box;
  z-index: 10;
}

.dictation-dock > view:first-child {
  flex: 1;
}

.dock-count {
  color: #173A62;
  font-size: 27rpx;
  font-weight: 900;
}

.dock-desc {
  margin-top: 4rpx;
  color: #7895AE;
  font-size: 21rpx;
}

.dock-button {
  min-width: 210rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #0C8F7E;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 900;
}
