<view class="page-shell" style="background: linear-gradient(180deg, {{theme.pageStart}}, {{theme.pageEnd}}); color: {{theme.textPrimary}};">
  <bc-top-bar title="{{title}}" show-back="{{true}}" bg-color="{{theme.pageStart}}" theme="{{theme}}" bind:back="onBack" />

  <scroll-view scroll-y class="page-body page-scroll">
    <bc-card theme="{{theme}}">
      <view class="symbol-display" style="background: linear-gradient(180deg, #E8FAFF, #FFFDF0); color: {{theme.textPrimary}};">{{phoneme.symbol}}</view>
      <view class="mt-sm">
        <bc-button text="{{playText}}" variant="primary" theme="{{theme}}" bind:tap="onPlaySymbol" />
      </view>
      <view class="mt-sm">
        <bc-alert title="{{mouthTitle}}" message="{{phoneme.mouthTip}}" theme="{{theme}}" />
      </view>
    </bc-card>

    <view class="section-title">{{wordsTitle}}</view>
    <block wx:for="{{phoneme.words}}" wx:key="text">
      <view class="mt-card">
      <bc-card theme="{{theme}}">
        <view class="word-row">
          <view class="word-main">
            <view class="word-text">{{item.text}}</view>
            <view class="word-tip" style="color: {{theme.textTertiary}};">{{item.tip}}</view>
          </view>
          <view class="word-play">
            <bc-button text="{{playText}}" variant="default" theme="{{theme}}" data-text="{{item.text}}" bind:tap="onPlayWord" />
          </view>
        </view>
      </bc-card>
      </view>
    </block>
  </scroll-view>

  <view class="page-action">
    <bc-button text="{{goCheckText}}" variant="primary" theme="{{theme}}" bind:tap="onGoCheck" />
  </view>
</view>
