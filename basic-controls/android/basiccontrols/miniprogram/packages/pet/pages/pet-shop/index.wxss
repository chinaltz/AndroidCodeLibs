.shop-summary { padding: 22rpx 24rpx; }
.shop-summary__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 18rpx; }
.shop-summary__title { min-width: 0; color: #173a62; font-size: 29rpx; font-weight: 900; line-height: 1.25; }
.shop-summary__points { flex: 0 0 auto; padding: 8rpx 16rpx; border-radius: 999rpx; background: #fff6d3; color: #a36500; font-size: 21rpx; font-weight: 900; white-space: nowrap; }
.shop-summary__note { margin-top: 12rpx; color: #718da8; font-size: 22rpx; line-height: 1.55; }
.category-tabs { display: grid; grid-template-columns: repeat(4,1fr); gap: 10rpx; margin-bottom: 18rpx; }.category-tabs view { min-height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #fff; color: #718da8; font-size: 22rpx; font-weight: 900; }.category-tabs .active { background: #e9fcf7; color: #087f74; border: 2rpx solid #43cfc7; }.shop-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; }.shop-card { min-width: 0; padding: 18rpx; border-radius: 26rpx; background: #fff; border: 2rpx solid #c9e9ff; transition: transform .12s ease, opacity .12s ease; }.shop-card.is-pressed { opacity: .9; transform: scale(.98); }.shop-card__image { width: 100%; height: 190rpx; border-radius: 18rpx; background: linear-gradient(180deg,#eef9ff,#f3ffe9); }.owned-count { margin: 8rpx 0; color: #087f74; font-size: 21rpx; font-weight: 900; }.shop-card .pet-small-button { margin-top: 14rpx; }
