.category-tabs { display: grid; grid-template-columns: repeat(4,1fr); gap: 10rpx; margin-bottom: 18rpx; }.category-tabs view { min-height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #fff; color: #718da8; font-size: 22rpx; font-weight: 900; }.category-tabs .active { background: #e9fcf7; color: #087f74; border: 2rpx solid #43cfc7; }.shop-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; }.shop-card { padding: 18rpx; border-radius: 26rpx; background: #fff; border: 2rpx solid #c9e9ff; }.shop-card image { width: 100%; height: 190rpx; }.owned-count { margin: 8rpx 0; color: #087f74; font-size: 21rpx; font-weight: 900; }.shop-card .pet-small-button { margin-top: 14rpx; }
