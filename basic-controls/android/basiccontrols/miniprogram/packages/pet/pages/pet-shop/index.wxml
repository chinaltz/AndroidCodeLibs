<view class="pet-page"><bc-top-bar title="星星商店" show-back="{{true}}" bg-color="{{theme.pageStart || '#DDF4FF'}}" theme="{{theme}}" bind:back="onBack" />
<scroll-view scroll-y class="pet-scroll"><view class="pet-card"><view class="pet-section-head"><view class="pet-section-title">固定价格 · 不抽卡</view><view class="pet-chip pet-chip--yellow">★ {{points}}</view></view><view class="pet-muted">积分不足时返回学习任务继续获得，不提供充值入口。</view></view>
<view class="category-tabs"><view class="{{category === 'all' ? 'active' : ''}}" data-category="all" bindtap="setCategory">全部</view><view class="{{category === 'food' ? 'active' : ''}}" data-category="food" bindtap="setCategory">食物</view><view class="{{category === 'toy' ? 'active' : ''}}" data-category="toy" bindtap="setCategory">玩具</view><view class="{{category === 'accessory' ? 'active' : ''}}" data-category="accessory" bindtap="setCategory">配饰</view></view>
<view class="shop-grid"><view wx:for="{{items}}" wx:key="id" class="shop-card" hover-class="is-pressed"><image class="shop-card__image" src="{{item.image}}" mode="aspectFit" lazy-load data-id="{{item.id}}" bindtap="buy" /><view class="pet-item-title">{{item.title}}</view><view class="pet-item-meta">{{item.desc || (item.type === 'food' ? '消耗品' : '购买后永久拥有')}}</view><view wx:if="{{item.count}}" class="owned-count">库存 {{item.count}}</view><view wx:if="{{item.owned || item.locked}}" class="pet-small-button pet-small-button--disabled">{{item.actionText}}</view><view wx:else class="pet-small-button" data-id="{{item.id}}" bindtap="buy">{{item.actionText}}</view></view></view>
</scroll-view></view>
