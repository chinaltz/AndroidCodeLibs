.growth-head { display: flex; align-items: center; gap: 20rpx; margin-bottom: 18rpx; padding: 24rpx; border-radius: 32rpx; background: linear-gradient(145deg,#fff4bd,#c9f7e9 55%,#b9e1ff); }.growth-head image { width: 200rpx; height: 230rpx; border-radius: 28rpx; }.growth-main { flex: 1; min-width: 0; }.growth-title { font-size: 36rpx; font-weight: 900; }.growth-xp { margin: 18rpx 0 10rpx; font-size: 22rpx; font-weight: 900; }.timeline { margin-bottom: 18rpx; padding: 6rpx 20rpx; border-radius: 30rpx; background: #fff; border: 2rpx solid #c9e9ff; }.milestone { display: flex; gap: 16rpx; padding: 22rpx 0; border-bottom: 2rpx solid #e8f3f8; opacity: .58; }.milestone:last-child { border-bottom: 0; }.milestone.is-unlocked { opacity: 1; }.milestone-dot { width: 60rpx; height: 60rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #edf2f5; color: #718da8; font-weight: 900; }.is-unlocked .milestone-dot { background: #e9fcf7; color: #087f74; }.milestone-title { font-size: 26rpx; font-weight: 900; }.growth-rule { margin-top: 12rpx; }
