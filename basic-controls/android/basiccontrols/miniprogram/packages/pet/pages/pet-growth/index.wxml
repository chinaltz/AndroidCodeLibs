<view class="pet-page"><bc-top-bar title="成长手册" show-back="{{true}}" bg-color="{{theme.pageStart || '#DDF4FF'}}" theme="{{theme}}" bind:back="onBack" />
<scroll-view scroll-y class="pet-scroll"><view class="growth-head"><image src="{{state.petImage}}" mode="aspectFit" lazy-load /><view class="growth-main"><view class="growth-title">{{state.profile.name}} · {{state.level}} 级</view><view class="pet-muted">{{state.stageTitle}} · {{state.adoptedDate}} 领养</view><view class="growth-stage-desc">{{state.stageDesc}}</view><view class="growth-xp">{{state.xp}} XP · {{state.nextText}}</view><view class="pet-progress"><view class="pet-progress__fill" style="{{state.progressStyle}}"></view></view><view class="next-stage">{{state.nextStageText}}</view></view></view>
<view class="timeline"><view wx:for="{{milestones}}" wx:key="level" class="milestone {{item.unlocked ? 'is-unlocked' : ''}}"><view class="milestone-dot">{{item.unlocked ? '✓' : item.level}}</view><view><view class="milestone-title">{{item.level}} 级 · {{item.title}}</view><view class="pet-item-meta">{{item.desc}}</view></view></view></view>
<view class="pet-card"><view class="pet-section-title">成长原则</view><view class="pet-muted growth-rule">经验值只会增加，不会因为购买、几天没学习或答错而减少。这里不展示失败次数，也不和其他孩子比较。</view></view>
</scroll-view></view>
