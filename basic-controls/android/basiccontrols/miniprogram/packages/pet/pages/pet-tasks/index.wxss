.task-note,.rule-copy { margin-top: 14rpx; }.task-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid #e8f3f8; }.task-row:last-child { border-bottom: 0; }.task-icon { width: 66rpx; height: 66rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #eaf6ff; color: #1678bd; font-weight: 900; }.task-row.is-done .task-icon { background: #e9fcf7; color: #087f74; }.task-reward { max-width: 150rpx; color: #a36500; font-size: 20rpx; font-weight: 900; text-align: right; }
