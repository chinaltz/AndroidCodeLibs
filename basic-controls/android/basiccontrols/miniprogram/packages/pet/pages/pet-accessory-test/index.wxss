.accessory-page { width: 100%; min-height: 100vh; overflow-x: hidden; background: linear-gradient(180deg, #ddf4ff, #f8fcff); }
.accessory-scroll { width: 100%; height: calc(100vh - 110rpx); overflow-x: hidden; padding: 18rpx 22rpx 0; box-sizing: border-box; }
.preview-stage { position: relative; height: 570rpx; border-radius: 30rpx; overflow: hidden; background: linear-gradient(180deg, #bde9ff 0 58%, #e8fbdc 58%); display: flex; align-items: center; justify-content: center; }
.preview-actor { position: relative; width: 430rpx; height: 500rpx; }.preview-pet { width: 100%; height: 100%; position: relative; z-index: 1; }
.preview-layer { position: absolute; pointer-events: none; }
.preview-caption { position: absolute; bottom: 14rpx; padding: 10rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.94); color: #365d82; font-size: 21rpx; font-weight: 900; }
.mode-row { display: grid; grid-template-columns: repeat(2,1fr); gap: 10rpx; margin-top: 14rpx; }.mode-row view { height: 68rpx; border-radius: 18rpx; background: #fff; color: #7895ae; line-height: 68rpx; text-align: center; font-size: 23rpx; font-weight: 900; }.mode-row .active { background: #1479d6; color: #fff; }
.preview-controls { display: grid; grid-template-columns: 70rpx 1fr 70rpx; align-items: center; margin-top: 12rpx; }.preview-controls > view:first-child,.preview-controls > view:last-child { height: 64rpx; border-radius: 18rpx; background: #fff; color: #1479d6; font-size: 42rpx; line-height: 60rpx; text-align: center; }.preview-name { text-align: center; }.preview-name strong,.preview-name text { display:block; }.preview-name strong { color:#173a62;font-size:26rpx; }.preview-name text { margin-top:3rpx;color:#7895ae;font-size:19rpx; }
.combo-add { height: 70rpx; margin-top: 12rpx; border-radius: 18rpx; background: #fff4bd; color: #8f5300; font-size: 22rpx; font-weight: 900; line-height: 70rpx; text-align: center; }
.slot-scroll { margin-top: 16rpx; white-space: nowrap; }.slot-row { display: inline-flex; gap: 10rpx; }.slot-tab { min-width: 94rpx; height: 62rpx; padding: 0 12rpx; border-radius: 18rpx; background:#fff;color:#7895ae;line-height:62rpx;text-align:center;font-size:22rpx;font-weight:900;box-sizing:border-box; }.slot-tab.active { background:#eaf6ff;color:#1479d6;border:2rpx solid #31a8ff;line-height:58rpx; }
.accessory-grid { width:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:14rpx;box-sizing:border-box; }.accessory-card { min-width:0;overflow:hidden;padding:12rpx;border-radius:22rpx;background:#fff;border:2rpx solid #d8eef8;box-sizing:border-box; }.accessory-card.is-selected { border-color:#31a8ff;box-shadow:0 8rpx 18rpx rgba(49,168,255,.15); }
.mini-actor { position:relative;width:180rpx;height:209rpx;margin:0 auto; }.mini-pet { width:100%;height:100%;position:relative;z-index:1; }.mini-layer { position:absolute;pointer-events:none; }
.card-title { color:#173a62;font-size:22rpx;font-weight:900;text-align:center; }.card-meta { margin-top:3rpx;color:#7895ae;font-size:18rpx;text-align:center; }.qa-note { margin-top:18rpx;padding:18rpx;border-radius:18rpx;background:#fff;color:#7895ae;font-size:20rpx;line-height:1.55; }.accessory-safe { height:calc(34rpx + env(safe-area-inset-bottom)); }
