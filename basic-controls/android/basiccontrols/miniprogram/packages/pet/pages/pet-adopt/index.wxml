<view class="pet-page">
  <bc-top-bar title="领养伙伴" show-back="{{true}}" bg-color="{{theme.pageStart || '#DDF4FF'}}" theme="{{theme}}" bind:back="onBack" />
  <scroll-view scroll-y class="pet-scroll">
    <view class="adopt-hero">
      <view class="pet-chip pet-chip--yellow">默认伙伴 · 晴空蓝</view>
      <image class="adopt-pet" src="{{petImage}}" mode="aspectFit" />
      <view class="adopt-title">领养一只星芽兽</view>
      <view class="pet-muted">完成音标、拼音和听写任务，它会和你一起升级、玩耍和收集装扮。</view>
    </view>
    <view class="pet-card">
      <view class="pet-section-head"><view class="pet-section-title">给伙伴起个名字</view><view class="pet-chip">1-8 个字</view></view>
      <input class="pet-name-input" value="{{name}}" maxlength="8" bindinput="onNameInput" />
      <view class="pet-muted">默认使用“芽芽”。宠物和学习数据只保存在当前孩子的本机档案中。</view>
    </view>
    <view class="pet-primary" bindtap="confirmAdopt">确认领养 · 获得 30 星星积分</view>
  </scroll-view>
</view>
