.check-audio-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.check-audio-action {
  flex: 1;
  min-width: 0;
}

.reward-card {
  margin-top: 24rpx;
  padding: 40rpx 28rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #D8EEF8;
  text-align: center;
  box-shadow: 0 18rpx 40rpx rgba(23, 58, 98, 0.1);
}

.reward-badge {
  display: inline-flex;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #E8FDF7;
  color: #0C8F7E;
  font-size: 23rpx;
  font-weight: 900;
}

.reward-title { margin-top: 24rpx; font-size: 42rpx; font-weight: 900; color: #173A62; }
.reward-points { margin-top: 20rpx; font-size: 52rpx; font-weight: 900; color: #F39A25; }
.reward-xp, .reward-tip { margin-top: 12rpx; font-size: 23rpx; line-height: 1.5; color: #7895AE; }

.reward-share {
  margin-top: 30rpx;
  min-height: 88rpx;
  border: 0;
  border-radius: 24rpx;
  background: #0C8F7E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 88rpx;
}

.reward-share::after { border: 0; }
.reward-link, .reward-back { margin-top: 18rpx; min-height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 900; }
.reward-link { color: #0C8F7E; }
.reward-back { border-radius: 22rpx; border: 2rpx solid #D6E4E0; color: #4A7A72; }
