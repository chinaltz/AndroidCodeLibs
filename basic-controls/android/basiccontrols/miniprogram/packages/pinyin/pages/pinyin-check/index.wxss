.step-track { display: flex; gap: 10rpx; margin-bottom: 18rpx; }
.step-dot { flex: 1; height: 12rpx; border-radius: 999rpx; background: #DCEAF3; }
.step-dot.is-active { background: #43CFC7; }

.listen-control {
  width: 88rpx;
  margin: 28rpx auto;
}

.option-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.record-symbol {
  min-height: 220rpx;
  margin-top: 24rpx;
  border-radius: 34rpx;
  background: #FFF5CF;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #173A62;
  font-size: 100rpx;
  font-weight: 900;
}

.audio-actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-top: 16rpx; }

.feedback {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #E8FDF7;
  color: #0C8F7E;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
}
