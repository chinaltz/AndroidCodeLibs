<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">音标星球</string>
    <string name="basic_controls_library_name">Basic Controls</string>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#DDF4FF</item>
        <item name="android:navigationBarColor">#F9FDFF</item>
    </style>
    <declare-styleable name="BasicView">
        
        <attr format="string" name="basicVariant"/>
        
        <attr format="string" name="basicText"/>
        
        <attr format="string" name="basicTextKey"/>
        
        <attr format="string" name="basicTitle"/>
        
        <attr format="string" name="basicMessage"/>
        
        <attr format="boolean" name="basicSelected"/>
        
        <attr format="boolean" name="basicDisabled"/>
    </declare-styleable>
</resources>